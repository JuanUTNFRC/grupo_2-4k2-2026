DJANGO_SECRET_KEY=cambiar-por-una-clave-secreta
# Modo debug: True solo en desarrollo.
DJANGO_DEBUG=True

# Hosts permitidos, separados por coma.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Email: con False los mails se imprimen en la terminal (no hace falta nada más).
# Con True se envían mails reales por SMTP y las credenciales son obligatorias.
DJANGO_EMAIL_SMTP=True
DJANGO_EMAIL_HOST=smtp.gmail.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=tu-cuenta@gmail.com
# App password de Google (no la contraseña de la cuenta).
DJANGO_EMAIL_HOST_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Remitente de los mails. Con Gmail tiene que ser la misma cuenta de HOST_USER.
DJANGO_DEFAULT_FROM_EMAIL=EcoHarmony Park <tu-cuenta@gmail.com>

POSTGRES_DB=ecoharmony
POSTGRES_USER=ecoharmony
POSTGRES_PASSWORD=ecoharmony
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

API_PORT=8000
CELERY_BROKER_URL=redis://localhost:6379/0